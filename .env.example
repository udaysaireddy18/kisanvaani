# KisanVaani environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
APP_BASE_URL=http://localhost:5000

# --- WhatsApp Cloud API (Meta) ---
# From Meta Developer Dashboard > WhatsApp > API Setup
WHATSAPP_VERIFY_TOKEN=replace-with-your-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=replace-with-your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# --- Speech-to-text ---
# OpenAI Whisper API key (primary STT)
OPENAI_API_KEY=replace-with-your-openai-api-key
STT_PROVIDER=openai
# Optional fallback: google (requires GOOGLE_APPLICATION_CREDENTIALS)
# STT_PROVIDER=google
# GOOGLE_APPLICATION_CREDENTIALS=path/to/google-credentials.json

# --- Database ---
DATABASE_URL=sqlite:///db/kisanvaani.db

# --- Dashboard ---
DASHBOARD_PASSWORD=change-me

# --- Storage ---
MEDIA_DIR=media
PDF_DIR=generated_pdfs
